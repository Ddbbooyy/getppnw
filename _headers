# Cloudflare Pages headers for getppnw.com
# Security + Performance + SEO

# Global security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://purepathnorthwest.com https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://api.stripe.com https://ppnw-api.dannyppnw.workers.dev https://purepathnorthwest.com https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://*.analytics.google.com https://region1.google-analytics.com; frame-src https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self'

# Aggressive caching for static assets (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

# HTML should revalidate but allow CDN caching
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/science/*
  Cache-Control: public, max-age=3600, s-maxage=86400

/how-it-works/*
  Cache-Control: public, max-age=3600, s-maxage=86400

/faq/*
  Cache-Control: public, max-age=3600, s-maxage=86400

# Block pages.dev subdomain from Google indexing
https://getppnw.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://*.getppnw.pages.dev/*
  X-Robots-Tag: noindex, nofollow
